# .env.ci
NODE_ENV=development
PORT=3000

# Base de données (doit correspondre à docker-compose.yml)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hrflow_dev
DB_USER=hrflow
DB_PASSWORD=hrflow_dev_pass  # ⬅️ Corrige pour correspondre à POSTGRES_PASSWORD dans docker-compose.yml

DATABASE_URL=postgresql://hrflow:hrflow_dev_pass@postgres:5432/hrflow_dev

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (doit correspondre à docker-compose.yml)
JWT_SECRET=dev_secret_local_only
JWT_REFRESH_SECRET=dev_refresh_secret_local_only
JWT_EXPIRY=24h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3007