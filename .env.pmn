# HRFlow — Variables d'environnement (exemple)
# Copier en .env et remplir avec de vraies valeurs. Ne jamais commiter .env.
# Les secrets de production vivent dans un secrets manager (voir Phase 3 du plan
# de remédiation), pas dans ce fichier.

NODE_ENV=development
PORT=3009
# Origines autorisées à appeler l'API (séparées par des virgules).
# En prod : https://hrflow.novatech.io,https://staging.hrflow.novatech.io
CORS_ALLOWED_ORIGINS=http://localhost:3009

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrflow_dev
DB_USER=hrflow_dev
DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=24h

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_S3_BUCKET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
